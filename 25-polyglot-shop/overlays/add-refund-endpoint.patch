@@ -62,3 +62,20 @@ pub async fn get_payment(
     .ok_or(AppError::NotFound)?;
     Ok(Json(payment))
 }
+
+/// Marks a settled payment refunded. The money goes back through the card network's own
+/// reversal, which is outside this service.
+pub async fn refund_payment(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+) -> Result<Json<Payment>, AppError> {
+    let payment = sqlx::query_as::<_, Payment>(
+        "UPDATE payments SET status = 'refunded' WHERE id = $1 AND status = 'settled' \
+         RETURNING id, order_id, amount_cents, status, created_at",
+    )
+    .bind(id)
+    .fetch_optional(&state.db)
+    .await?
+    .ok_or(AppError::NotFound)?;
+    Ok(Json(payment))
+}
